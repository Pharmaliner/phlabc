{
  "name": "pharmaline/phlabc",
  "description": "Pharmaline Extension to manage access to objects, content and actions with permissions.",
  "autoload": {
    "psr-4": {
      "Pharmaline\\PhlAbc\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pharmaline\\PhlAbc\\Tests\\": "tests"
    }
  },
  "license": "GPL-3.0-or-later",
  "type": "typo3-cms-extension",
  "version": "1.1.0",
  "keywords": ["TYPO3", "TYPO3 Extension", "Security", "TYPO3 Frontend Login", "TYPO3 Felogin"],
  "authors": [
    {
      "name": "Christian Platt",
      "role": "Project Owner",
      "email": "christian.platt@pharmaline.de",
      "homepage": "https://www.pharmaline.de"
    },
    {
      "name": "Eike Drost",
      "role": "Maintainer",
      "email": "eike.drost@mceikens.de",
      "homepage": "https://www.mceikens.de"
    },
    {
      "name": "Holger Krämer",
      "role": "Maintainer",
      "email": "post@holgerkraemer.com",
      "homepage": "https://www.holgerkraemer.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": "^8.4",
    "ext-yaml": "*",
    "typo3/cms-cli": "^3.1",
    "typo3/cms-core": "^13",
    "typo3/cms-extbase": "^13",
    "typo3/cms-felogin": "^13",
    "typo3/cms-fluid": "^13.4",
    "typo3/cms-frontend": "^13",
    "composer/composer": "^2.8",
    "symfony/console": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "typo3fluid/fluid": "^4.3",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0.2",
    "doctrine/dbal": "^4.3.5"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-strict-rules": "^1.5"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "phlabc"
    }
  },
  "readme": "README.md",
  "support": {
    "issues": "https://github.com/Pharmaliner/phlabc/issues"
  }
}
